---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** แสดงปุ่ม "เช็กเครื่องของฉัน" ใน header หลังจากปุ่มใน hero (#hero-cta) เลื่อนพ้นจอแล้ว */
  headerCta?: boolean;
}

const { title, description, headerCta = false } = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-[100dvh] font-sans antialiased">
    <header class="fixed inset-x-0 top-3 z-20 px-4">
      <div
        class="mx-auto flex h-14 max-w-5xl items-center justify-between rounded-full border border-line bg-surface px-5 shadow-[0_8px_30px_-12px_oklch(0.3_0.03_255/0.25)] backdrop-blur-md"
      >
        <a href="/" class="text-lg font-bold tracking-tight">
          AITidBaan <span class="font-medium text-muted">AIติดบ้าน</span>
        </a>
        {
          headerCta && (
            <a
              id="header-cta"
              href="/wizard#step-1"
              tabindex="-1"
              aria-hidden="true"
              class="pointer-events-none translate-y-1 rounded-full bg-accent px-5 py-2 text-sm font-semibold text-accent-ink opacity-0 transition duration-300 active:scale-[0.98] data-[show]:pointer-events-auto data-[show]:translate-y-0 data-[show]:opacity-100"
            >
              เช็กเครื่องของฉัน
            </a>
          )
        }
      </div>
    </header>
    <slot />
    {
      headerCta && (
        <script>
          const heroCta = document.getElementById('hero-cta');
          const headerCta = document.getElementById('header-cta');
          if (heroCta && headerCta) {
            new IntersectionObserver(([entry]) => {
              const show = !entry.isIntersecting;
              headerCta.toggleAttribute('data-show', show);
              headerCta.setAttribute('aria-hidden', String(!show));
              headerCta.tabIndex = show ? 0 : -1;
            }).observe(heroCta);
          }
        </script>
      )
    }
  </body>
</html>
