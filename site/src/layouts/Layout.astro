---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-[100dvh] font-sans antialiased">
    <!-- header เป็น pill เล็กลอยมุมซ้ายแบบ fastwork hero จะได้ดูโปร่ง -->
    <header class="pointer-events-none fixed inset-x-0 top-4 z-20 px-4">
      <div class="mx-auto flex max-w-6xl items-center justify-between">
        <a
          href="/"
          class="pointer-events-auto inline-flex h-12 items-center gap-1.5 rounded-full border border-line/70 bg-surface/80 px-5 text-lg font-bold tracking-tight shadow-[0_8px_30px_-14px_oklch(0.3_0.03_255/0.3)] backdrop-blur-md transition hover:bg-surface"
        >
          AITidBaan <span class="font-medium text-muted">AIติดบ้าน</span>
        </a>
        <!-- ปุ่มเปลี่ยนภาษา: ยังไม่ทำงาน ใส่ไว้ก่อนให้หน้าตาครบ -->
        <button
          type="button"
          aria-label="เปลี่ยนภาษา"
          class="pointer-events-auto inline-flex h-12 items-center gap-2 rounded-full border border-line/70 bg-surface/80 px-4 text-base font-bold shadow-[0_8px_30px_-14px_oklch(0.3_0.03_255/0.3)] backdrop-blur-md transition hover:bg-surface"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" />
          </svg>
          TH
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
      </div>
    </header>
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
