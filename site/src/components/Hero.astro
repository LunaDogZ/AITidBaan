---
// hero แบบ fastwork.com/selling: หัวข้อกลางจอมีคำที่หมุนเปลี่ยน, การ์ดของจริงลอยรอบสองข้าง,
// กล่องตัวเลข, ปุ่มเด่น และลิงก์ชวนเลื่อนต่อ เลื่อนลงแล้วการ์ดกระจายออก เนื้อหาจางหายช้ากว่าการเลื่อน
// การ์ดเป็นคำสั่ง + คำตอบจริงของ Gemma 4 E4B จาก results/raw (ข้อ -01 ของแต่ละงาน)
import { ArrowRightIcon, CaretDownIcon, CheckCircleIcon } from '@phosphor-icons/react/dist/ssr';
import examples from '../data/examples.json';
import { MODELS, TASKS } from '../data/models';
import type { Task } from '../lib/recommend';

// คำที่หมุนในหัวข้อ ใช้ชื่องานทดสอบเดียวกับการ์ดและส่วนตัวอย่าง
const WORDS = TASKS.map((t) => t.label);

const model = MODELS.find((m) => m.id === 'gemma-4-e4b')!;
const answers = (examples.answers as Record<string, Record<Task, string>>)[model.rawId];
const prompts = examples.prompts as Record<Task, string>;

// ตัดเครื่องหมาย markdown และประโยคเกริ่น ("แน่นอนค่ะ นี่คือ...:") ให้เหลือเนื้อคำตอบสั้นๆ
const snippet = (s: string, max: number) => {
  const paras = s
    .split(/\n+/)
    .map((l) => l.replace(/[*#>|`]|^\s*[-:]+\s*$|^\s*[-*]\s+/g, '').trim())
    .filter(Boolean);
  if (paras.length > 1 && paras[0].length < 90 && /[:：]$/.test(paras[0])) paras.shift();
  const t = paras.join(' ');
  return t.length <= max ? t : t.slice(0, max).trimEnd() + ' ...';
};

// ตำแหน่งการ์ด: 3 ใบซ้าย 3 ใบขวา เอียงคนละมุม (side เป็นระยะจากขอบซ้ายหรือขวา)
const SLOTS = [
  { side: 'left', x: '1%', y: '12%', tilt: -4 },
  { side: 'left', x: '5.5%', y: '41%', tilt: 3 },
  { side: 'left', x: '0.5%', y: '70%', tilt: -2 },
  { side: 'right', x: '1.5%', y: '9%', tilt: 4 },
  { side: 'right', x: '6%', y: '38%', tilt: -3 },
  { side: 'right', x: '1%', y: '67%', tilt: 2.5 },
] as const;

// การ์ดมีเท่าที่มีช่องวาง ถ้าเพิ่มงานทดสอบต้องเพิ่ม SLOTS ด้วย
const cards = TASKS.slice(0, SLOTS.length).map((t, i) => ({
  ...SLOTS[i],
  label: t.label,
  prompt: snippet(prompts[t.id].split('\n')[0], 46),
  answer: snippet(answers[t.id], 72),
}));
---

<section id="hero" class="hero relative isolate flex min-h-[100dvh] items-center justify-center overflow-hidden px-4 pt-24 pb-16">
  <!-- พื้นหลังไล่สีอ่อนรอบกลางจอ ให้หัวข้อมีมิติ -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60rem_36rem_at_50%_42%,var(--accent-soft),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="orbit pointer-events-none absolute inset-0 hidden xl:block" aria-hidden="true">
    {
      cards.map((c, i) => (
        <div
          class="orbit-slot absolute w-[clamp(12.5rem,16.5vw,16rem)]"
          data-side={c.side}
          style={`${c.side}: ${c.x}; top: ${c.y}; --i: ${i}`}
        >
          <div class="orbit-card" style={`rotate: ${c.tilt}deg`}>
            <div class="rounded-2xl border border-line/80 bg-surface p-4 shadow-[0_18px_40px_-22px_oklch(0.3_0.06_262/0.45)]">
              <p class="ml-auto w-fit max-w-[92%] rounded-2xl rounded-br-md bg-accent px-3 py-2 text-sm leading-snug text-accent-ink">
                {c.prompt}
              </p>
              <p class="mt-2 max-w-[95%] rounded-2xl rounded-bl-md bg-sunk px-3 py-2 text-sm leading-snug">{c.answer}</p>
              <p class="mt-3 flex items-center gap-1.5 text-sm font-semibold">
                <CheckCircleIcon weight="fill" size={16} className="text-good" /> {c.label}
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="hero-content relative mx-auto flex max-w-[40rem] flex-col items-center text-center">
    <h1 class="text-[2.1rem] leading-[1.22] min-[400px]:text-[2.5rem] font-semibold tracking-[-0.02em] text-balance sm:text-6xl lg:text-[4.25rem]">
      <span class="sr-only">{WORDS.join(' ')} ด้วย AI บนคอมคุณเอง</span>
      <span aria-hidden="true" class="block">
        {/* ช่องสูง 1.7em เพราะสระบนล่างและวรรณยุกต์ไทยล้นบรรทัดปกติ ถ้าแคบกว่านี้ส่วนล่างของคำก่อนหน้าจะโผล่เข้ามา
            ใช้ margin ติดลบชดเชยไม่ให้ระยะบรรทัดห่างขึ้น และไล่จางขอบบนล่าง */}
        <span class="rotator relative -my-[0.24em] inline-grid h-[1.7em] overflow-hidden align-bottom text-accent [mask-image:linear-gradient(transparent,black_14%,black_86%,transparent)]">
          <span class="rotator-track flex flex-col">
            {
              [...WORDS, WORDS[0]].map((w) => (
                <span class="flex h-[1.7em] items-center justify-center whitespace-nowrap">{w}</span>
              ))
            }
          </span>
        </span>
      </span>
      <span aria-hidden="true" class="block">ด้วย AI บนคอมคุณเอง</span>
    </h1>

    <p data-reveal style="--i: 1" class="mt-6 max-w-[36ch] text-xl leading-relaxed text-muted text-balance">
      สอนเรื่อง AI ออฟไลน์ (หรือที่สายเทคเรียกว่า Local LLM) ตั้งแต่เช็กเครื่อง เลือกตัวที่เหมาะ จนติดตั้งใช้ได้จริงทีละขั้น
    </p>

    <a
      id="hero-cta"
      href="/wizard#step-1"
      data-wizard-cta
      data-reveal
      style="--i: 2"
      class="group mt-9 inline-flex items-center gap-2.5 rounded-full bg-accent px-8 py-4 text-xl font-semibold text-accent-ink shadow-[0_14px_30px_-12px_var(--accent)] transition duration-300 ease-[var(--ease-out)] hover:-translate-y-0.5 hover:shadow-[0_20px_36px_-12px_var(--accent)] active:scale-[0.98]"
    >
      <span data-cta-label>มาเริ่มติดตั้งกันเลย!</span>
      <ArrowRightIcon size={22} weight="bold" className="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
    </a>
    <a
      href="#examples"
      data-reveal
      style="--i: 3"
      class="group mt-6 inline-flex flex-col items-center text-muted transition hover:text-ink"
    >
      ดูตัวอย่างคำตอบจริง
      <CaretDownIcon size={20} weight="bold" className="hint-bounce mt-1" aria-hidden="true" />
    </a>
  </div>
</section>

<script>
  import { scroll } from 'motion';

  const hero = document.getElementById('hero')!;
  const track = hero.querySelector<HTMLElement>('.rotator-track')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // คำที่หมุน: เลื่อนขึ้นทีละคำ พอถึงคำสุดท้าย (สำเนาคำแรก) ก็กระโดดกลับไปคำแรกโดยไม่มีแอนิเมชัน
  if (!reduce) {
    const count = track.children.length - 1;
    let i = 0;
    const step = () => {
      if (document.hidden) return;
      i += 1;
      track.style.transition = 'transform 0.7s var(--ease-out)';
      track.style.transform = `translateY(${(-i * 100) / (count + 1)}%)`;
      if (i === count) {
        setTimeout(() => {
          track.style.transition = 'none';
          track.style.transform = 'translateY(0)';
          i = 0;
        }, 750);
      }
    };
    setInterval(step, 2400);

    // เลื่อนออกจาก hero: ตั้ง --p (0 ถึง 1) ให้ CSS กระจายการ์ดและจางเนื้อหา แบบ --exit ของ fastwork
    // เนื้อหาจางเกือบหมดที่ GONE (opacity = 1 - 1.5p) แล้วปิดไม่ให้กดหรือ tab ไปถึง และบอกหน้าให้โชว์ CTA ลอย
    const GONE = 0.55;
    const content = hero.querySelector<HTMLElement>('.hero-content')!;
    let gone = false;
    scroll(
      (p: number) => {
        hero.style.setProperty('--p', String(p));
        if (p >= GONE !== gone) {
          gone = p >= GONE;
          content.inert = gone;
          hero.dispatchEvent(new CustomEvent('hero:gone', { detail: gone, bubbles: true }));
        }
      },
      { target: hero, offset: ['start start', 'end start'] },
    );
  }
</script>

<style>
  .hero {
    --p: 0;
  }
  .hero-content {
    opacity: calc(1 - var(--p) * 1.5);
    transform: translateY(calc(var(--p) * 6rem)) scale(calc(1 - var(--p) * 0.06));
  }
  .orbit-slot {
    opacity: calc(1 - var(--p) * 1.3);
    transform: translate(calc(var(--p) * -9rem), calc(var(--p) * -4rem));
  }
  .orbit-slot[data-side='right'] {
    transform: translate(calc(var(--p) * 9rem), calc(var(--p) * -4rem));
  }

  @media (prefers-reduced-motion: no-preference) {
    /* การ์ดลอยเข้ามาตอนโหลด แล้วขยับขึ้นลงช้าๆ (ใช้ scale/translate แยกจาก transform ของการเลื่อน) */
    .orbit-card {
      animation:
        orbit-in 1.1s var(--ease-out) both,
        orbit-float 7s ease-in-out infinite;
      animation-delay: calc(0.25s + var(--i) * 0.09s), calc(var(--i) * -1.3s);
    }
    .hero h1 {
      animation: fade-in 0.9s var(--ease-out) both;
    }
    :global(.hint-bounce) {
      animation: hint-bounce 2s ease-in-out infinite;
    }
  }

  @keyframes orbit-in {
    from {
      opacity: 0;
      scale: 0.82;
    }
  }
  @keyframes orbit-float {
    50% {
      translate: 0 -10px;
    }
  }
  @keyframes hint-bounce {
    50% {
      translate: 0 4px;
    }
  }
</style>
