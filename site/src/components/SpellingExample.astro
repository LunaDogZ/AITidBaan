---
// ตัวอย่างจริงจาก testset/spelling-01 และคำตอบของ Gemma 4 E4B ใน results/raw/gemma-4-e4b-it/spelling-01.json
// ผลประเมินยังเป็นข้อมูลตัวอย่างจนกว่าผู้ให้คะแนนจะส่งผล
import { CheckCircleIcon } from '@phosphor-icons/react/dist/ssr';
import { SAMPLE_DATA, TEST_DATE } from '../data/models';
---

<figure class="rounded-2xl border border-line bg-surface p-5 shadow-[0_24px_60px_-28px_oklch(0.3_0.04_255/0.35)] sm:p-6">
  <figcaption class="flex flex-wrap items-center justify-between gap-2 text-sm">
    <span class="font-semibold">งานทดสอบ: ตรวจคำผิดในประกาศ HR</span>
    <span class="text-muted">ทดสอบเมื่อ {TEST_DATE}</span>
  </figcaption>

  <div class="mt-4 rounded-xl bg-sunk p-4 text-base">
    <p class="text-sm font-medium text-muted">ต้นฉบับ</p>
    <p class="mt-1">
      ผู้ที่จะเข้าพื้นที่ไลน์ผลิตต้องสวมหมวกนิรภัยปิด<mark
        class="rounded bg-bad-soft px-0.5 text-bad underline decoration-wavy underline-offset-4">ศรีษะ</mark
      >และรองเท้านิรภัยทุกครั้ง หากผู้ใดไม่ปฏิบัติตาม เจ้าหน้าที่ความปลอดภัยจะไม่<mark
        class="rounded bg-bad-soft px-0.5 text-bad underline decoration-wavy underline-offset-4">อนุญาติ</mark
      >ให้เข้าพื้นที่
    </p>
  </div>

  <div class="mt-3 rounded-xl border border-line p-4 text-base">
    <p class="text-sm font-medium text-muted">คำตอบจริงจาก Gemma 4 E4B (ตัดมาบางส่วน)</p>
    <p class="mt-1">
      ผู้ที่จะเข้าพื้นที่ไลน์ผลิตต้องสวมหมวกนิรภัยคลุม<mark class="rounded bg-good-soft px-0.5 text-good">ศีรษะ</mark
      >และรองเท้านิรภัยทุกครั้ง หากผู้ใดไม่ปฏิบัติตาม เจ้าหน้าที่ความปลอดภัยจะไม่<mark class="rounded bg-good-soft px-0.5 text-good">อนุญาต</mark>ให้เข้าพื้นที่
    </p>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-good-soft px-3 py-1 text-sm font-semibold text-good">
      <CheckCircleIcon weight="fill" size={18} aria-hidden="true" /> ใช้ได้เลย
    </span>
    {SAMPLE_DATA && <span class="text-sm text-muted">ผลประเมินเป็นข้อมูลตัวอย่าง</span>}
  </div>
</figure>
