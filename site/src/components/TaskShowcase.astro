---
// เลื่อนแล้วสลับงานแบบ profile showcase ของ fastwork: เมนูซ้ายค้างไว้ การ์ดขวาเปลี่ยนตามการเลื่อน
// จอเล็กกว่า lg หรือตั้ง reduced motion: การ์ดเรียงลงมาธรรมดา
import { CheckCircleIcon } from '@phosphor-icons/react/dist/ssr';
import examples from '../data/examples.json';
import { MODELS, SAMPLE_DATA, TASKS, TEST_DATE, TIER_LABEL } from '../data/models';
import type { Task } from '../lib/recommend';
import { renderMd } from '../lib/markdown';
import type { Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };

const model = MODELS.find((m) => m.id === 'gemma-4-e4b')!;
const answers = (examples.answers as Record<string, Record<Task, string>>)[model.rawId];
const prompts = examples.prompts as Record<Task, string>;

const items = TASKS[lang].map((t) => ({
  ...t,
  instruction: prompts[t.id].split('\n')[0],
  answer: renderMd(answers[t.id]),
  good: model.ratings[t.id]?.good ?? 0,
  total: Object.values(model.ratings[t.id] ?? {}).reduce((a, b) => a + b, 0),
}));

// คำสั่งและคำตอบเป็นภาษาไทยทั้งสองภาษา เพราะเว็บทดสอบงานเอกสารไทย ฉบับอังกฤษจึงบอกไว้ตรงหัวข้อ
const T = {
  th: {
    title: 'ดูคำตอบจริงทีละงาน',
    lead: `คำตอบจาก ${model.name} โมเดลสำหรับ${TIER_LABEL.th[model.tier]} ทดสอบเมื่อ ${TEST_DATE.th}`,
    nav: 'งานทดสอบ',
    prompt: 'คำสั่งที่ใช้ทดสอบ',
    answer: `คำตอบจริงจาก ${model.name}`,
    fullAnswer: (label: string) => `คำตอบเต็มของงาน${label}`,
    scrollHint: 'เลื่อนในกรอบเพื่ออ่านคำตอบต่อ',
    good: (good: number, total: number) => `ใช้ได้เลย ${good} จาก ${total} ข้อ`,
    sample: 'ผลประเมินเป็นข้อมูลตัวอย่าง',
  },
  en: {
    title: 'Real answers, task by task',
    lead: `Answers from ${model.name}, a model for a ${TIER_LABEL.en[model.tier].toLowerCase()}, tested ${TEST_DATE.en}. The documents and answers are in Thai, because that is what we test.`,
    nav: 'Test tasks',
    prompt: 'Test prompt',
    answer: `Real answer from ${model.name}`,
    fullAnswer: (label: string) => `Full answer for ${label}`,
    scrollHint: 'Scroll inside the box to keep reading',
    good: (good: number, total: number) => `Usable as-is: ${good} of ${total}`,
    sample: 'Scores are sample data',
  },
}[lang];
---

<section id="examples" class="showcase-track relative">
  <div class="showcase-stage mx-auto max-w-5xl px-4 py-20">
    <div class="grid gap-10 lg:grid-cols-[16rem_1fr] lg:gap-12">
      <!-- หัวข้ออยู่คอลัมน์ซ้ายเหนือเมนู การ์ดทางขวาจะได้สูงเกือบเต็มจอ -->
      <div class="min-w-0">
        <div data-reveal>
          <h2 class="text-3xl leading-snug font-bold tracking-tight md:text-4xl lg:text-3xl">{T.title}</h2>
          <p class="mt-3 text-muted">{T.lead}</p>
        </div>
        <nav aria-label={T.nav} class="showcase-nav mt-8 hidden lg:block">
        <ol class="space-y-1">
          {
            items.map((it, i) => (
              <li>
                <a
                  href={`#example-${it.id}`}
                  data-index={i}
                  class="showcase-tab block py-1.5 text-xl leading-snug text-muted/70 transition-[color,font-size] duration-500 hover:text-ink"
                >
                  {it.label}
                </a>
              </li>
            ))
          }
        </ol>
        </nav>
      </div>

      <div class="showcase-cards grid min-w-0 gap-6">
        {
          items.map((it, i) => (
            <article
              id={`example-${it.id}`}
              data-index={i}
              class="showcase-card flex min-w-0 scroll-mt-28 flex-col rounded-2xl border border-line bg-surface p-6 shadow-[0_24px_60px_-34px_oklch(0.3_0.04_255/0.4)] sm:p-8"
            >
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-2xl font-bold">{it.label}</h3>
                <span class="text-muted">{it.hint}</span>
              </div>
              <div class="mt-5 rounded-xl bg-sunk p-4">
                <p class="text-sm font-medium text-muted">{T.prompt}</p>
                <p class="mt-1 line-clamp-2" lang="th" title={it.instruction}>{it.instruction}</p>
              </div>
              <div class="answer-wrap mt-4 flex min-h-0 flex-col">
                <p class="text-sm font-medium text-muted">{T.answer}</p>
                {/* คำตอบยาว: เลื่อนอ่านในกรอบได้ อ่านจนสุดแล้วล้อเมาส์จะเลื่อนหน้าต่อเอง */}
                <div
                  class="answer md mt-2 max-h-[26rem] min-h-0 overflow-y-auto overscroll-auto rounded-xl border border-line p-4"
                  tabindex="0"
                  aria-label={T.fullAnswer(it.label)}
                  lang="th"
                  set:html={it.answer}
                />
                <p class="scroll-hint mt-2 text-sm text-muted">{T.scrollHint}</p>
              </div>
              <p class="mt-5 flex flex-wrap items-center gap-3">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-good-soft px-3 py-1 font-semibold text-good">
                  <CheckCircleIcon weight="fill" size={18} aria-hidden="true" /> {T.good(it.good, it.total)}
                </span>
                {SAMPLE_DATA && <span class="text-sm text-muted">{T.sample}</span>}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { scroll } from 'motion';

  const track = document.querySelector<HTMLElement>('.showcase-track');
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.showcase-tab')];
  const cards = [...document.querySelectorAll<HTMLElement>('.showcase-card')];
  // เงื่อนไขต้องตรงกับ @media ใน <style>
  const mode = matchMedia('(min-width: 1024px) and (min-height: 700px) and (prefers-reduced-motion: no-preference)');
  let active = -1;

  const setActive = (i: number) => {
    if (i === active) return;
    active = i;
    tabs.forEach((t, n) => t.toggleAttribute('data-active', n === i));
    cards.forEach((c, n) => c.toggleAttribute('data-active', n === i));
  };

  // ตำแหน่งเลื่อนที่ทำให้งานที่ i แสดง: แบ่งระยะที่ stage ค้างเป็น 6 ช่วงเท่ากัน แล้วไปกลางช่วง
  const scrollFor = (i: number) => {
    const top = track!.getBoundingClientRect().top + scrollY;
    const distance = track!.offsetHeight - innerHeight;
    return top + ((i + 0.5) / cards.length) * distance;
  };

  // คำบอก "เลื่อนในกรอบ" กับเงาไล่จางด้านล่าง แสดงเฉพาะตอนที่ยังอ่านไม่จบ
  for (const box of document.querySelectorAll<HTMLElement>('.showcase-card .answer')) {
    const update = () =>
      box.toggleAttribute('data-more', box.scrollTop + box.clientHeight < box.scrollHeight - 4);
    box.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(box);
  }

  if (track && mode.matches) {
    setActive(0);
    scroll(
      (progress: number) => setActive(Math.min(cards.length - 1, Math.floor(progress * cards.length))),
      { target: track, offset: ['start start', 'end end'] },
    );
    tabs.forEach((t, i) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        scrollTo({ top: scrollFor(i), behavior: 'smooth' });
      }),
    );
  }
</script>

<style>
  .scroll-hint {
    visibility: hidden;
  }
  .answer[data-more] {
    mask-image: linear-gradient(to bottom, black 80%, transparent);
  }
  .answer[data-more] + .scroll-hint {
    visibility: visible;
  }

  .showcase-tab[data-active] {
    color: var(--ink);
    font-size: 1.75rem;
    font-weight: 700;
  }

  @media (min-width: 1024px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    /* ระยะเลื่อนต่องานประมาณ 60vh */
    .showcase-track {
      height: calc(100dvh + 6 * 60vh);
    }
    .showcase-stage {
      position: sticky;
      top: 0;
      min-height: 100dvh;
      padding-top: 6rem;
      padding-bottom: 1.5rem;
    }
    .showcase-cards {
      display: grid;
    }
    /* การ์ดซ้อนกันในช่องเดียว สลับด้วย opacity + เลื่อนขึ้นนิดหน่อย */
    .showcase-card {
      grid-area: 1 / 1;
      opacity: 0;
      transform: translateY(24px) scale(0.98);
      pointer-events: none;
      transition:
        opacity 0.5s var(--ease-out),
        transform 0.6s var(--ease-out);
    }
    .showcase-card[data-active] {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    /* การ์ดสูงพอดีจอ ส่วนคำตอบยืดเต็มที่ที่เหลือแล้วเลื่อนอ่านในกรอบ */
    .showcase-cards {
      height: calc(100dvh - 7.5rem);
      /* แถวเดียวสูงเท่ากรอบ ไม่ให้ขยายตามความยาวคำตอบ */
      grid-template-rows: minmax(0, 1fr);
    }
    .showcase-card {
      min-height: 0;
    }
    .showcase-card .answer-wrap {
      flex: 1;
    }
    .showcase-card .answer {
      flex: 1;
      max-height: none;
    }
  }
</style>
