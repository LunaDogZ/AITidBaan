---
import { CopyIcon } from '@phosphor-icons/react/dist/ssr';
import Layout from '../layouts/Layout.astro';
import Wizard from '../components/wizard/Wizard';
---

<Layout title="เช็กเครื่องของฉัน | AITidBaan" description="ตอบคำถามสเปกเครื่องไม่กี่ข้อ แล้วรับคำแนะนำ AI ออฟไลน์ตัวเดียวที่เหมาะกับคุณ">
  <main>
    <!-- วิซาร์ดต้องทำบนคอมที่จะติดตั้ง (PRD ข้อ 4 หลักการ UX/UI) -->
    <div class="max-md:pointer-coarse:hidden">
      <Wizard client:media="(min-width: 768px), (pointer: fine)" />
    </div>
    <section class="hidden px-4 pt-28 pb-16 max-md:pointer-coarse:block">
      <h1 class="text-2xl font-bold">ขั้นตอนนี้ต้องทำบนคอมที่จะติดตั้ง</h1>
      <p class="mt-3 text-muted">คัดลอกลิงก์นี้ไปเปิดบนคอม Windows ของคุณ แล้วเริ่มเช็กเครื่องได้เลย</p>
      <button
        id="copy-link"
        type="button"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-semibold text-accent-ink active:scale-[0.98]"
      >
        <CopyIcon size={18} weight="bold" aria-hidden="true" /> <span>คัดลอกลิงก์</span>
      </button>
    </section>
  </main>
</Layout>

<script>
  const btn = document.getElementById('copy-link');
  btn?.addEventListener('click', async () => {
    const label = btn.querySelector('span')!;
    try {
      await navigator.clipboard.writeText(location.href.split('#')[0]);
      label.textContent = 'คัดลอกแล้ว';
    } catch {
      label.textContent = 'คัดลอกไม่ได้ ลองกดค้างที่ช่อง URL';
    }
  });
</script>
