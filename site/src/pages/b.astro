---
// ทิศทาง B: ได้แรงบันดาลใจจาก interaction ของ fastwork.com/selling
// 1) hero กลายร่าง: เลื่อนแล้วข้อความจางหาย การ์ดตัวอย่างเลื่อนมากลางจอกลายเป็นเนื้อหา
// 2) ฉากปัญหาค้างไว้ แล้วการ์ดทางออกเลื่อนขึ้นมาทับ
// 3) เลื่อนแล้วสลับงาน (TaskShowcase) และ CTA ลอยด้านล่าง
// แบบเดียวกับ fastwork: JS อ่านระยะเลื่อนแล้วตั้งตัวแปร CSS (--p) จึงทำงานทุกเบราว์เซอร์
// จอเล็ก/เตี้ย หรือตั้ง reduced motion: hero เป็นหน้านิ่ง
import { ArrowRightIcon, CheckIcon } from '@phosphor-icons/react/dist/ssr';
import Layout from '../layouts/Layout.astro';
import SpellingExample from '../components/SpellingExample.astro';
import TaskShowcase from '../components/TaskShowcase.astro';
import { TASKS } from '../data/models';
import { PROBLEMS, STEPS } from '../data/home';

const notes = [
  { text: 'เอกสารลูกค้าเป็นความลับ ห้ามเอาขึ้น ChatGPT', tilt: -3 },
  { text: '7B, Q4, GGUF คืออะไรกันแน่', tilt: 2 },
  { text: 'โน้ตบุ๊กออฟฟิศฉันจะรันไหวไหม', tilt: -1.5 },
  { text: 'ตัวไหนเขียนภาษาไทยได้ดีจริง', tilt: 3 },
  { text: 'ลองโหลดมาแล้ว ตอบเป็นภาษาจีน', tilt: -2 },
];
---

<Layout
  title="AITidBaan (AIติดบ้าน) | AI ออฟไลน์ภาษาไทยสำหรับงานเอกสาร"
  description="แนะนำ AI ออฟไลน์ (Local LLM) ที่ทำงานเอกสารภาษาไทยได้จริงบนเครื่องของคุณ พร้อมผลทดสอบและคู่มือติดตั้งทีละขั้น"
>
  <main>
    <section class="hero-track relative">
      <div class="hero-stage mx-auto grid min-h-[100dvh] max-w-5xl items-center gap-12 px-4 pt-24 pb-16 lg:grid-cols-[1fr_30rem] lg:gap-8">
        <div class="hero-copy">
          <h1 data-reveal class="text-4xl leading-[1.25] font-bold tracking-tight md:text-5xl md:leading-[1.2]">
            AI ช่วยงานเอกสาร<br />ที่ทำงานบนคอมคุณเอง
          </h1>
          <p data-reveal style="--i: 1" class="mt-5 max-w-[34ch] text-xl text-muted">
            ตอบคำถามเรื่องเครื่องไม่กี่ข้อ แล้วรับคำแนะนำ AI ออฟไลน์ (หรือที่สายเทคเรียกว่า Local LLM) ตัวเดียวที่เหมาะกับคุณ
          </p>
          <a
            id="hero-cta"
            href="/wizard#step-1"
            data-reveal
            style="--i: 2"
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-lg font-semibold text-accent-ink transition hover:brightness-110 active:scale-[0.98]"
          >
            เช็กเครื่องของฉัน <ArrowRightIcon size={20} weight="bold" aria-hidden="true" />
          </a>
        </div>
        <!-- data-reveal อยู่ข้างใน เพราะ .hero-card ใช้ transform ของการกลายร่าง -->
        <div class="hero-card relative">
          <p class="hero-caption text-center text-xl font-semibold">นี่คือคำตอบจริงจากโมเดลบนเครื่อง ไม่ใช่ภาพประกอบ</p>
          <div data-reveal style="--i: 3"><SpellingExample /></div>
        </div>
      </div>
    </section>

    <section class="relative">
      <div class="pain-stage flex min-h-[100dvh] flex-col justify-center overflow-hidden bg-scene px-4 py-24 text-scene-ink md:sticky md:top-0">
        <div class="mx-auto w-full max-w-5xl">
          <h2 data-reveal class="text-3xl leading-snug font-bold tracking-tight md:text-4xl">อยากให้ AI ช่วยงาน แต่ติดตรงนี้</h2>
          <ul class="mt-12 flex flex-wrap gap-3 sm:gap-5">
            {
              notes.map((n, i) => (
                <li data-reveal style={`--i: ${i + 1}`}>
                  <p
                    class="w-[calc(50vw-1.4rem)] rounded-2xl bg-surface p-4 text-lg leading-snug font-medium shadow-[0_20px_40px_-24px_oklch(0.3_0.06_262/0.5)] sm:w-60 sm:p-5 sm:text-xl"
                    style={`rotate: ${n.tilt}deg`}
                  >
                    {n.text}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <!-- ให้ฉากปัญหาค้างไว้ครู่หนึ่งก่อนการ์ดทางออกเลื่อนขึ้นมาทับ -->
      <div class="hidden h-[45vh] md:block" aria-hidden="true"></div>

      <div class="relative z-10 -mt-24 rounded-t-[2rem] bg-bg shadow-[0_-24px_60px_-30px_oklch(0.3_0.06_262/0.35)]">
        <div class="mx-auto max-w-5xl px-4 py-20">
          <h2 data-reveal class="max-w-[22ch] text-3xl leading-snug font-bold tracking-tight md:text-4xl">
            AITidBaan แก้ให้ทีละเรื่อง
          </h2>
          <dl class="mt-10 space-y-8">
            {
              PROBLEMS.map(({ icon: Icon, title, body }, i) => (
                <div data-reveal style={`--i: ${i}`} class="grid gap-2 md:grid-cols-[22rem_1fr] md:gap-10">
                  <dt class="flex items-start gap-3 font-semibold">
                    <Icon size={26} className="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
                    {title}
                  </dt>
                  <dd class="pl-9 text-muted md:pl-0">{body}</dd>
                </div>
              ))
            }
          </dl>

          <div data-reveal class="mt-16 grid gap-6 rounded-2xl bg-sunk p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8">
            <div>
              <p class="text-xl font-bold">ทดสอบเองกับงานที่คนออฟฟิศทำจริง</p>
              <p class="mt-2 max-w-[52ch] text-muted">
                5 โมเดล 6 งาน รวม 155 คำตอบ ผู้ให้คะแนน 2 คนอ่านโดยไม่เห็นชื่อโมเดล
                และมีข้อหลอกไว้จับว่าโมเดลแต่งตัวเลขขึ้นเองหรือเปล่า
              </p>
            </div>
            <ul class="flex max-w-md flex-wrap gap-2 md:justify-end">
              {TASKS.map((t) => <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm">{t.label}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <TaskShowcase />

    <section class="mx-auto max-w-5xl px-4 py-20">
      <h2 data-reveal class="text-3xl leading-snug font-bold tracking-tight md:text-4xl">พาทำทีละขั้น จนถามเอกสารของคุณได้</h2>
      <p data-reveal class="mt-3 text-muted">คู่มือนี้สำหรับ Windows</p>
      <ol class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          STEPS.map((s, i) => (
            <li data-reveal style={`--i: ${i}`} class="flex gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full border border-line font-semibold tabular-nums">
                {i + 1}
              </span>
              <div>
                <p class="font-semibold">{s.title}</p>
                <p class="text-muted">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="final-cta" class="mx-auto max-w-5xl px-4 pb-24">
      <div data-reveal class="flex flex-col items-start justify-between gap-6 rounded-2xl bg-accent p-8 text-accent-ink md:flex-row md:items-center">
        <div>
          <p class="text-2xl font-bold">เริ่มจากเช็กเครื่องก่อน</p>
          <p class="mt-1 opacity-90">ฟรี ไม่ต้องสมัคร ใช้เวลาประมาณ 2 นาที</p>
        </div>
        <a
          href="/wizard#step-1"
          class="inline-flex items-center gap-2 rounded-full bg-surface px-7 py-3.5 font-semibold text-ink transition hover:brightness-95 active:scale-[0.98]"
        >
          เช็กเครื่องของฉัน <ArrowRightIcon size={20} weight="bold" aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-8 text-sm text-muted sm:flex-row sm:justify-between">
      <p>AITidBaan (AIติดบ้าน) เว็บฟรี ทำโดยคนคนเดียว</p>
      <p>AI ประมวลผลบนเครื่องคุณ เว็บนี้แค่แนะนำ</p>
    </div>
  </footer>

  <div
    id="float-cta"
    aria-hidden="true"
    class="pointer-events-none fixed inset-x-0 bottom-5 z-20 flex translate-y-4 justify-center px-4 opacity-0 transition duration-500 ease-[var(--ease-out)] data-[show]:pointer-events-auto data-[show]:translate-y-0 data-[show]:opacity-100"
  >
    <div class="flex items-center gap-4 rounded-full border border-line bg-surface py-2 pr-2 pl-5 shadow-[0_16px_40px_-16px_oklch(0.3_0.04_255/0.45)]">
      <span class="hidden items-center gap-1.5 text-muted sm:flex">
        <CheckIcon size={18} weight="bold" className="text-good" aria-hidden="true" /> ฟรี ไม่ต้องสมัคร ประมาณ 2 นาที
      </span>
      <a
        href="/wizard#step-1"
        tabindex="-1"
        class="rounded-full bg-accent px-5 py-2.5 font-semibold text-accent-ink transition hover:brightness-110 active:scale-[0.98]"
      >
        เช็กเครื่องของฉัน
      </a>
    </div>
  </div>
</Layout>

<script>
  import { scroll } from 'motion';

  // ข้อความ hero หายหมดที่ p = COPY_END (สัดส่วนของระยะที่ stage ค้าง) ต้องตรงกับ 0.21 ใน .hero-copy ของ <style>
  const COPY_END = 0.21;
  // เงื่อนไขต้องตรงกับ html.morph ใน <style> และเปลี่ยนได้เมื่อย่อขยายหน้าต่าง
  const morphQuery = matchMedia(
    '(prefers-reduced-motion: no-preference) and (min-width: 1024px) and (min-height: 760px)',
  );
  const root = document.documentElement;
  const track = document.querySelector<HTMLElement>('.hero-track')!;
  const copy = document.querySelector<HTMLElement>('.hero-copy')!;
  const heroCta = document.getElementById('hero-cta')!;
  const finalCta = document.getElementById('final-cta')!;
  const float = document.getElementById('float-cta')!;
  const floatLink = float.querySelector('a')!;

  let copyGone = false;
  let heroCtaSeen = true;
  let finalSeen = false;

  const updateFloat = () => {
    const morphs = root.classList.contains('morph');
    const show = (morphs ? copyGone : !heroCtaSeen) && !finalSeen;
    float.toggleAttribute('data-show', show);
    float.setAttribute('aria-hidden', String(!show));
    floatLink.tabIndex = show ? 0 : -1;
  };

  new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.target === heroCta) heroCtaSeen = e.isIntersecting;
      if (e.target === finalCta) finalSeen = e.isIntersecting;
    }
    updateFloat();
  }).observe(heroCta);
  new IntersectionObserver(([e]) => {
    finalSeen = e.isIntersecting;
    updateFloat();
  }).observe(finalCta);

  // แบบ fastwork: อ่านความคืบหน้าการเลื่อนแล้วตั้ง --p ให้ CSS คำนวณท่าทางเอง
  scroll(
    (p: number) => {
      track.style.setProperty('--p', String(p));
      const gone = p >= COPY_END;
      if (gone !== copyGone) {
        copyGone = gone;
        copy.inert = gone; // จางหมดแล้วกดหรือ tab ไปที่ปุ่มที่มองไม่เห็นไม่ได้
        updateFloat();
      }
    },
    { target: track, offset: ['start start', 'end end'] },
  );

  const applyMode = () => {
    root.classList.toggle('morph', morphQuery.matches);
    if (!morphQuery.matches) copy.inert = false;
    updateFloat();
  };
  applyMode();
  morphQuery.addEventListener('change', applyMode);
</script>

<style>
  .hero-caption {
    display: none;
  }

  :global(html.morph) .hero-track {
    --p: 0;
    height: 220vh;
  }
  :global(html.morph) .hero-stage {
    position: sticky;
    top: 0;
    height: 100dvh;
  }
  /* ช่วงของแต่ละท่า (สัดส่วนของ --p): ข้อความ 0-0.21, การ์ดเลื่อนกลาง 0.05-0.55, คำบรรยาย 0.5-0.7 */
  :global(html.morph) .hero-copy {
    --t: clamp(0, var(--p) / 0.21, 1);
    opacity: calc(1 - var(--t));
    filter: blur(calc(var(--t) * 8px));
    transform: translateY(calc(var(--t) * -2rem));
  }
  /* การ์ดอยู่คอลัมน์ขวากว้าง 30rem ในกรอบ 62rem: เลื่อนซ้าย 16rem = กึ่งกลางพอดี */
  :global(html.morph) .hero-card {
    --t: clamp(0, (var(--p) - 0.05) / 0.5, 1);
    /* ease-out แบบง่าย: 1 - (1 - t)^2 */
    --e: calc(1 - (1 - var(--t)) * (1 - var(--t)));
    transform: translateX(calc(var(--e) * -16rem)) scale(calc(1 + var(--e) * 0.1));
  }
  :global(html.morph) .hero-caption {
    --t: clamp(0, (var(--p) - 0.5) / 0.2, 1);
    display: block;
    position: absolute;
    inset-inline: -4rem;
    bottom: calc(100% + 2rem);
    opacity: var(--t);
    transform: translateY(calc((1 - var(--t)) * 1rem));
  }
</style>
